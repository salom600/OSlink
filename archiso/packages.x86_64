# AetherOS Package List - x86_64
# Only packages from official Arch repos OR Chaotic-AUR (pre-built binaries)
# AUR-only packages WITHOUT Chaotic-AUR availability are excluded
# Grouped by category for maintainability

# === BASE SYSTEM ===
base
linux-lts
linux-firmware
systemd
systemd-sysvcompat
dbus
# NOTE: elogind REMOVED — systemd already provides systemd-logind

# === BOOT & FILESYSTEM ===
grub
syslinux
efibootmgr
os-prober
squashfs-tools
dosfstools
mtools
ntfs-3g
exfatprogs          # Renamed from exfat-utils (removed from Arch repos)
fuse2
fuse3

# === NETWORKING ===
networkmanager
dnsmasq
iptables-nft
nftables
wireless_tools
wpa_supplicant
bluez
bluez-utils

# === AUDIO/VIDEO ===
pipewire
pipewire-alsa
pipewire-jack
pipewire-pulse
pipewire-zeroconf
wireplumber
alsa-utils
pavucontrol

# === WAYLAND DISPLAY ===
wayland
xorg-xwayland
hyprland
hyprpaper
swaylock              # swaylock-effects is AUR-only; use swaylock from official repos
wl-clipboard
cliphist
grim
slurp
wofi
mako
# NOTE: nwg-dock-hyprland and nwg-launchers are AUR-only
# They will be installed from Chaotic-AUR if available, otherwise skipped
# Dock alternative: we use a custom waybar config to emulate dock behavior

# === DESKTOP COMPONENTS ===
waybar
foot
thunar
thunar-volman
mousepad
file-roller
imv
mpv
zathura
zathura-pdf-musl

# === SHELL & UTILITIES ===
fish
bash
sudo
nano
vim
less
man-db
man-pages
texinfo
which
hwinfo
lshw
usbutils
pciutils
smartmontools
dmidecode
inxi

# === THEMING ===
kvantum
qt5ct
qt6ct
gtk-engine-murrine
# NOTE: gtk-engines REMOVED — GTK2-era legacy, no longer in official repos
adwaita-icon-theme
hicolor-icon-theme

# === XDG & DESKTOP INTEGRATION ===
xdg-utils
xdg-user-dirs
xdg-desktop-portal
xdg-desktop-portal-hyprland
xdg-desktop-portal-gtk
desktop-file-utils

# === POLKIT & AUTH ===
polkit
polkit-gnome

# === APP STORE ===
# NOTE: bauh is AUR-only — handled via Chaotic-AUR or post-install download
flatpak
# NOTE: snapd REMOVED — AUR-only and unnecessary overhead for AetherOS

# === INSTALLER ===
calamares
# NOTE: calamares-branding-aetheros REMOVED — custom package, not in any repo
# Branding is handled by overlay files in airootfs/etc/calamares/branding/

# === ARCHIVE & COMPRESS ===
tar
unzip
zip
7zip                # Renamed from p7zip (deprecated, removed from repos)
rsync
curl
wget

# === FONT ===
ttf-inter
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
noto-fonts-extra

# === GAMING ===
steam
wine
gamescope
gamemode
lib32-gamemode
mangohud
lib32-mangohud
vulkan-radeon
lib32-vulkan-radeon
vulkan-icd-loader
lib32-vulkan-icd-loader
mesa
lib32-mesa
vulkan-mesa-layers
lib32-vulkan-mesa-layers

# === NVIDIA (optional, auto-detected on first boot) ===
nvidia-dkms
nvidia-utils
lib32-nvidia-utils
nvidia-settings
egl-wayland

# === CODECS ===
ffmpeg
gst-plugins-base
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav
libdvdcss
libdvdnav
libdvdread

# === POWER & LAPTOP ===
acpid
upower
tlp
brightnessctl

# === SECURITY ===
firejail
apparmor
earlyoom

# === ARCHISO BUILD ===
archiso
arch-install-scripts
squashfs-tools

# === DEVELOPMENT (minimal, for build support) ===
base-devel
git
cmake
meson
python
python-pip

# === VIRTUALIZATION SUPPORT ===
qemu-guest-agent
spice-vdagent

# === MISCELLANEOUS ===
zram-generator
glibc
lib32-glibc
ca-certificates
openssl
# NOTE: crda REMOVED — obsolete, kernel handles regulatory domain natively
# NOTE: haveged REMOVED — obsolete, modern kernels use getrandom()
